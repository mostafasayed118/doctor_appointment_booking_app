// Doctor photos are public catalog assets (the app loads them by URL with
// no auth); nothing writes via the client — the seed script (admin SDK)
// uploads them and bypasses these rules.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /doctor-photos/{imageId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
