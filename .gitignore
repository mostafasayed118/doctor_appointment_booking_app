# Miscellaneous
*.class

# Freebuff agent local data (session DB, caches)
.freebuff/

*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Seed script secrets — the service account key is console-generated and
# must NEVER be committed (the pre-commit safety check scans for it).
tool/seed/service-account.json
.env
.env.*

# Node (seed script dependencies)
node_modules/

# Generated doctor photos — the seed writes these into the hosting public
# dir (deterministic output, regenerable via `node tool/seed/index.js`).
public/

# Firebase CLI local cache (project aliases, deploy metadata)
.firebase/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
